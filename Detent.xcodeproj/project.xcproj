{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "Detent", "target-membership": [ "Detent" ] },
    { "kind": "folder", "path": "detent-cli", "target-membership": [ "detent-cli" ] },
    { "kind": "folder", "path": "Detent iOS", "target-membership": [ "Detent iOS" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Detent", "Detent iOS", "detent-cli" ] },
    { "kind": "folder", "path": "AppShared", "target-membership": [ "Detent", "Detent iOS" ] },
    { "path": "chrome-extension", "type": "folder", "target-membership": [ "Detent/resources" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Detent.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Detent iOS.app", "id": "000000000000000000000122", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/detent", "id": "000000000000000000000121", "type": "compiled.mach-o.executable", "index": false, "target-membership": [ { "build-phase": "Detent/copy/Embed Command Line Tool", "code-sign-on-copy": true } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Detent",
      "id": "000000000000000100000000",
      "product": "Products/Detent.app",
      "product-type": "application",
      "dependencies": [
        "detent-cli",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Command Line Tool",
          "bundle-base-path": "root",
          "relative-path": "Contents/Helpers",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "Config/Detent.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "9",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/../Frameworks",
        "MARKETING_VERSION": "1.4.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.colinbm.detent",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "Detent iOS",
      "id": "000000000000000300000000",
      "product": "Products/Detent iOS.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/Detent-iOS.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "Detent",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Detent uses the camera to scan 2FA setup QR codes.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "MARKETING_VERSION": "1.0.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.colinbm.detent.ios",
        "PRODUCT_MODULE_NAME": "DetentiOS",
        "PRODUCT_NAME": "Detent iOS",
        "SDKROOT": "iphoneos",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
